# ============================================================================
#  Pixel 8 Pro (husky) 自签名 ROM 制作工具 —— 配置文件
#  用法: cp config.env.example config.env 后按需修改
# ============================================================================

# --- 目标设备 ---------------------------------------------------------------
DEVICE_CODENAME="husky"              # Pixel 8 Pro 代号（Pixel 8 = shiba）
LINEAGE_VERSION="24.0"               # LineageOS 版本（24.0 = 当前稳定线）

# --- Android 源码树（必填）-------------------------------------------------
# LineageOS 源码根目录，即包含 build/envsetup.sh 的目录
ANDROID_BUILD_TOP="/home/you/lineage"

# --- 签名密钥 ----------------------------------------------------------------
# template（推荐）: 使用 LineageOS 官方模板 lineage/scripts/lineage-priv-template
#                   keys.sh 会自动生成全部密钥 + avb.pk8 + avb_custom_key.bin
# manual         : 使用 ~/.android-certs 手工生成的密钥（需自行生成 APEX 密钥）
KEYS_MODE="template"
# KEYS_MODE=manual 时填写密钥目录（template 模式留空）
KEYS_DIR=""

# --- AVB / bootloader 回锁 ---------------------------------------------------
# true: 构建时用自建 AVB 密钥签名 vbmeta（配合 avb_custom_key.bin 支持回锁）
WITH_AVB="true"

# --- 自定义 OTA 更新源 -------------------------------------------------------
# 系统更新 App 会读取 lineage.updater.uri 属性，并替换 {device}/{type}/{incr} 占位符。
# ⚠️ LineageOS 24 起：更新源 URL 必须 HTTPS 且直接返回 200（OkHttp 不跟随重定向）。
UPDATER_BASE_URL="https://updates.example.com/updates.json"
# OTA 文件对外下载地址（用户实际下载 zip 的根地址）
OTA_DOWNLOAD_BASE="https://updates.example.com/downloads"
# 版本类型（对应 ro.lineage.releasetype，写入 updates.json 的 type 字段）
RELEASE_TYPE="UNOFFICIAL"

# --- blu_spark 内核（可选）---------------------------------------------------
# blu_spark 内核源码仓库（Pixel 6/7/8/9 系列）
BLUSPARK_REPO="https://github.com/engstk/gs"
# 是否在构建前注入 blu_spark 内核（true/false）
BLUSPARK_INJECT="false"

# --- 输出目录 ----------------------------------------------------------------
OUT_DIR="/home/you/release"
