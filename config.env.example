# ============================================================================
#  Pixel 8 Pro (husky) 自签名 ROM 重打包工具 —— 配置文件
#
#  本工具在【免费版 GitHub runner】上运行，核心思路：
#    解包官方 LineageOS OTA → 追加 lineage.updater.uri → 替换 blu_spark boot
#    → avbroot 重新打包签名 → 发布 Releases + 更新源(updates.json)
#
#  用法（本地调试）: cp config.env.example config.env 后按需修改。
#  在 CI 中：此文件可省略，所有变量由 GitHub workflow 的环境变量注入。
# ============================================================================

# --- 目标设备 ---------------------------------------------------------------
DEVICE_CODENAME="husky"

# --- 上游 LineageOS v2 API ---------------------------------------------------
# 用于检测新版本 + 下载官方 OTA（返回裸 JSON 数组）
LINEAGE_API_BASE="https://download.lineageos.org/api/v2/devices"

# --- blu_spark 内核 -----------------------------------------------------------
# blu_spark 内核 GitHub 仓库（owner/repo），自动匹配 gs-los 版 boot 镜像
# gs-los = LineageOS 专用；gs(无 los) = 官方 A17；gs-los-next = KSU-Next
BLUSPARK_REPO="engstk/gs"

# --- avbroot（重打包 + 重签名核心工具，独立 Rust 二进制）----------------------
AVBROOT_VERSION="3.39.1"
# x86_64-unknown-linux-gnu 压缩包 sha256（用于下载后校验）
AVBROOT_SHA256="145378039c372a1c80f3d0df7bdbe59b4ca6f612c10949da426278bb8b9994d7"

# --- 自定义 OTA 更新源 --------------------------------------------------------
# 写入 product/build.prop 的 lineage.updater.uri 属性。
# 留空 = 自动从 GitHub Pages 推导: https://<owner>.github.io/<repo>/updates.json
# ⚠️ 必须 HTTPS 且直接返回 200（LineageOS 24 Updater 不跟随重定向）。
UPDATER_BASE_URL=""

# --- 工作目录 -----------------------------------------------------------------
# 中间产物目录（相对仓库根，会被 .gitignore 忽略）
WORK_DIR=".work"
